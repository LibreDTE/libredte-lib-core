#
# Definición de variables de entorno para los tests de LibreDTE.
#
# Para configurar se debe renombrar este archivo a env-tests con:
#   $ mv env-tests-dist env-tests
#
# Las variables se deben cargar antes de ejecutar los tests ejecutando:
#   $ source tests/env-tests
#

# OpenSSL con el proveedor legacy activo, para certificados con cifrado
# 40BitRC2. Se debe cargar el archivo desde la raíz del proyecto. Si el
# certificado usa un cifrado moderno se puede omitir.
export OPENSSL_CONF="$(pwd)/tests/openssl-legacy.cnf"

# Certificado digital.
export LIBREDTE_CERTIFICATE_FILE=""
export LIBREDTE_CERTIFICATE_PASS=""

# Correo electrónico (los tests usan una cuenta de Gmail).
export MAIL_USERNAME=""
export MAIL_PASSWORD=""
