#
# Environment variable definitions for LibreDTE tests.
#
# To configure, rename this file to env-tests with:
#   $ mv env-tests-dist env-tests
#
# The variables should be loaded before running the tests by executing:
#   $ source tests/env-tests
#

# OpenSSL with the legacy provider enabled, for certificates using
# 40BitRC2 encryption. The file should be loaded from the root of the project.
# If the certificate uses modern encryption, this can be omitted.
export OPENSSL_CONF="$(pwd)/tests/openssl-legacy.cnf"

# Digital certificate.
export LIBREDTE_CERTIFICATE_FILE=""
export LIBREDTE_CERTIFICATE_PASS=""

# Email account (the tests use a Gmail account).
export MAIL_USERNAME=""
export MAIL_PASSWORD=""
